// Серверная процедура отправки готового JSON. Запрос остатков и расписание
// настраиваются в центральной УТ отдельно. Секреты поступают из настроек.
Процедура ОтправитьОстатки(ХостСайта, СервисныйТокенСайта, ТокенОбмена, ТелоJSON) Экспорт
	Если ПустаяСтрока(ХостСайта) Или ПустаяСтрока(СервисныйТокенСайта) Или ПустаяСтрока(ТокенОбмена) Тогда
		ВызватьИсключение "PEAK: не заданы параметры обмена остатками.";
	КонецЕсли;

	Соединение = Новый HTTPСоединение(ХостСайта, 443, , , , 90, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос = Новый HTTPЗапрос("/api/sync/stock");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("OAI-Sites-Authorization", "Bearer " + СервисныйТокенСайта);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + ТокенОбмена);
	Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "PEAK: выгрузка остатков не принята, HTTP " + Строка(Ответ.КодСостояния);
	КонецЕсли;
КонецПроцедуры
