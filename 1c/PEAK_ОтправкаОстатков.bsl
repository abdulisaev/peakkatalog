// Серверные процедуры обмена с сайтом PEAK. Запрос остатков и расписание
// настраиваются в центральной УТ отдельно. Секреты поступают из настроек.
// Не запускалось на рабочей базе: проверить в копии.

Процедура ОтправитьОстатки(ХостСайта, СервисныйТокенСайта, ТокенОбмена, ТелоJSON) Экспорт
	ОтправитьНаСайт(ХостСайта, СервисныйТокенСайта, ТокенОбмена, "/api/sync/stock", ТелоJSON);
КонецПроцедуры

// Штрихкоды для поиска и сканирования на сайте. Достаточно раз в сутки или после загрузки новой коллекции.
// Тело: {"updatedAt": "...", "rows": [["4605246012341", "EXT263547B", "black", "41"], ...]}
Процедура ОтправитьШтрихкоды(ХостСайта, СервисныйТокенСайта, ТокенОбмена) Экспорт
	ОтправитьНаСайт(ХостСайта, СервисныйТокенСайта, ТокенОбмена, "/api/sync/barcodes", ШтрихкодыJSON());
КонецПроцедуры

// УТ 11: регистр «Штрихкоды упаковок товаров». Цвет и размер берутся из наименования
// характеристики «цвет|размер» — так же, как в отчёте «Остатки и доступность товаров».
Функция ШтрихкодыJSON() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ш.Штрихкод КАК Штрихкод,
	|	Ш.Номенклатура.Артикул КАК Артикул,
	|	ЕСТЬNULL(Ш.Характеристика.Наименование, """") КАК Характеристика
	|ИЗ
	|	РегистрСведений.ШтрихкодыУпаковокТоваров КАК Ш
	|ГДЕ
	|	Ш.Номенклатура.Артикул <> """"
	|	И Ш.Штрихкод <> """"";
	Выборка = Запрос.Выполнить().Выбрать();

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("updatedAt");
	Запись.ЗаписатьЗначение(ДатаISO(ТекущаяДатаСеанса()));
	Запись.ЗаписатьИмяСвойства("rows");
	Запись.ЗаписатьНачалоМассива();
	Уже = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Выборка.Штрихкод);
		Если Уже[Код] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Код, Истина);
		Части = СтрРазделить(Выборка.Характеристика, "|", Истина);
		Цвет = ?(Части.Количество() > 0, СокрЛП(Части[0]), "");
		Размер = ?(Части.Количество() > 1, СокрЛП(Части[1]), "");
		Запись.ЗаписатьНачалоМассива();
		Запись.ЗаписатьЗначение(Код);
		Запись.ЗаписатьЗначение(СокрЛП(Выборка.Артикул));
		Запись.ЗаписатьЗначение(Цвет);
		Запись.ЗаписатьЗначение(Размер);
		Запись.ЗаписатьКонецМассива();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
КонецФункции

Функция ДатаISO(Дата)
	// Время сервера 1С по Москве.
	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss") + "+03:00";
КонецФункции

Процедура ОтправитьНаСайт(ХостСайта, СервисныйТокенСайта, ТокенОбмена, Путь, ТелоJSON)
	Если ПустаяСтрока(ХостСайта) Или ПустаяСтрока(СервисныйТокенСайта) Или ПустаяСтрока(ТокенОбмена) Тогда
		ВызватьИсключение "PEAK: не заданы параметры обмена с сайтом.";
	КонецЕсли;

	Соединение = Новый HTTPСоединение(ХостСайта, 443, , , , 90, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("OAI-Sites-Authorization", "Bearer " + СервисныйТокенСайта);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + ТокенОбмена);
	Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "PEAK: сайт не принял данные " + Путь + ", HTTP " + Строка(Ответ.КодСостояния)
			+ Символы.ПС + Лев(Ответ.ПолучитьТелоКакСтроку(), 300);
	КонецЕсли;
КонецПроцедуры
